---
import BaseLayout from '../layouts/BaseLayout.astro';

// Placeholder gallery. Real images live in public/images/gallery/ — see
// CLAUDE.md's "Gallery / Photo Uploads" section for the naming convention
// and the decision tree for how a given client should add new photos.
const placeholders = [
	'/images/gallery/placeholder-1.svg',
	'/images/gallery/placeholder-2.svg',
	'/images/gallery/placeholder-3.svg',
];

// Repeated to give the page enough scroll length to test Lenis — trim back
// down to real, unique client photos before launch.
const images = Array.from({ length: 12 }, (_, i) => ({
	src: placeholders[i % placeholders.length],
	alt: 'Replace with a real, descriptive alt text for this photo',
}));
---

<BaseLayout title="Gallery" description="A look at our work.">
	<section class="container section">
		<h1>Gallery</h1>
		<ul class="gallery-grid">
			{images.map((image) => (
				<li>
					<img src={image.src} alt={image.alt} loading="lazy" />
				</li>
			))}
		</ul>
	</section>
</BaseLayout>

<style>
	.section {
		padding-block: var(--space-2xl);
	}

	.gallery-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--space-md);
	}

	.gallery-grid img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius-md);
		background: var(--color-bg-subtle);
	}
</style>
