---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';

// Placeholder content throughout this page — replace every field with the
// client's real offering before launch. Structure follows the standard
// service-business page pattern (problem → offer → process → pricing →
// social proof → FAQ → CTA) since that's what visitors and search/AI
// answer engines both expect from a services page.

const problems = [
	{
		title: 'Replace with a problem your client solves',
		description: 'Describe the pain point from the visitor’s point of view — what’s frustrating or costly about not having this handled.',
	},
	{
		title: 'Replace with a second problem',
		description: 'Keep it specific and concrete rather than generic — visitors recognize themselves in specifics, not buzzwords.',
	},
	{
		title: 'Replace with a third problem',
		description: 'Three is usually enough to establish credibility without turning this into a wall of text.',
	},
];

const services = [
	{
		title: 'Service one',
		description: 'Replace with a real description of what this includes.',
		includes: ['Replace with what’s included', 'Replace with what’s included', 'Replace with what’s included'],
	},
	{
		title: 'Service two',
		description: 'Replace with a real description of what this includes.',
		includes: ['Replace with what’s included', 'Replace with what’s included', 'Replace with what’s included'],
	},
	{
		title: 'Service three',
		description: 'Replace with a real description of what this includes.',
		includes: ['Replace with what’s included', 'Replace with what’s included', 'Replace with what’s included'],
	},
];

const steps = [
	{ title: 'Reach out', description: 'Replace with how a visitor starts — a call, a form, a quote request.' },
	{ title: 'We build a plan', description: 'Replace with what happens next — an assessment, a proposal, a scheduled visit.' },
	{ title: 'Get results', description: 'Replace with the outcome the client walks away with.' },
];

const pricingTiers = [
	{
		name: 'Starter',
		price: '$X',
		unit: '/ project',
		description: 'Replace with who this tier is for.',
		features: ['Replace with a feature', 'Replace with a feature', 'Replace with a feature'],
		featured: false,
	},
	{
		name: 'Standard',
		price: '$X',
		unit: '/ project',
		description: 'Replace with who this tier is for.',
		features: ['Everything in Starter', 'Replace with a feature', 'Replace with a feature', 'Replace with a feature'],
		featured: true,
	},
	{
		name: 'Premium',
		price: '$X',
		unit: '/ project',
		description: 'Replace with who this tier is for.',
		features: ['Everything in Standard', 'Replace with a feature', 'Replace with a feature'],
		featured: false,
	},
];

const testimonials = [
	{
		quote: 'Replace with a real quote from a client — specific results read as more credible than generic praise.',
		name: 'Client name',
		role: 'Replace with their role or company',
	},
	{
		quote: 'Replace with a second real quote, ideally from a different type of client to show range.',
		name: 'Client name',
		role: 'Replace with their role or company',
	},
];

const faqs = [
	{
		question: 'Replace with a real question clients actually ask',
		answer: 'Replace with a direct, specific answer — this doubles as AEO content, so phrase both the question and answer the way a person would actually ask and expect to hear it.',
	},
	{
		question: 'How long does a typical project take?',
		answer: 'Replace with a real timeframe or range.',
	},
	{
		question: 'What areas or industries do you serve?',
		answer: 'Replace with real service-area or industry detail.',
	},
	{
		question: 'How do I get started?',
		answer: 'Replace with the real first step — usually a link back to the contact page.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer,
		},
	})),
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	provider: {
		'@type': 'LocalBusiness',
		name: SITE_TITLE,
	},
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Services',
		itemListElement: services.map((service) => ({
			'@type': 'Offer',
			itemOffered: {
				'@type': 'Service',
				name: service.title,
				description: service.description,
			},
		})),
	},
};
---

<BaseLayout
	title="Services"
	description="What we offer, how it works, and what it costs — everything you need to know before reaching out."
>
	<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<section class="container section hero">
		<h1>Services</h1>
		<p class="lead">
			One or two sentences summarizing the range of services and the outcome a client gets —
			lead with the result, the same way the homepage headline does.
		</p>
		<a href="/contact/" class="btn btn-primary">Get a free quote</a>
	</section>

	<section class="container section">
		<h2>Common problems we solve</h2>
		<ul class="problem-grid">
			{problems.map((problem) => (
				<li class="problem-card">
					<h3>{problem.title}</h3>
					<p>{problem.description}</p>
				</li>
			))}
		</ul>
	</section>

	<section class="container section bg-subtle">
		<h2>What we offer</h2>
		<ul class="service-grid">
			{services.map((service) => (
				<li class="service-card">
					<h3>{service.title}</h3>
					<p>{service.description}</p>
					<ul class="includes-list">
						{service.includes.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</li>
			))}
		</ul>
	</section>

	<section class="container section">
		<h2>How it works</h2>
		<ol class="step-list">
			{steps.map((step, i) => (
				<li class="step">
					<span class="step-number" aria-hidden="true">{i + 1}</span>
					<h3>{step.title}</h3>
					<p>{step.description}</p>
				</li>
			))}
		</ol>
	</section>

	<section class="container section bg-subtle">
		<h2>Pricing</h2>
		<p class="section-note">Starting prices below — every project is a little different, so treat these as a guide and reach out for an exact quote.</p>
		<ul class="pricing-grid">
			{pricingTiers.map((tier) => (
				<li class:list={['pricing-card', { featured: tier.featured }]}>
					{tier.featured && <p class="pricing-badge">Most popular</p>}
					<h3>{tier.name}</h3>
					<p class="pricing-price">{tier.price}<span class="pricing-unit">{tier.unit}</span></p>
					<p class="pricing-description">{tier.description}</p>
					<ul class="pricing-features">
						{tier.features.map((feature) => (
							<li>{feature}</li>
						))}
					</ul>
					<a href="/contact/" class={`btn ${tier.featured ? 'btn-primary' : 'btn-secondary'} pricing-cta`}>Get started</a>
				</li>
			))}
		</ul>
	</section>

	<section class="container section">
		<h2>What clients say</h2>
		<ul class="testimonial-grid">
			{testimonials.map((t) => (
				<li>
					<blockquote class="testimonial-card">
						<p>&ldquo;{t.quote}&rdquo;</p>
						<footer>
							<cite>{t.name}</cite>{t.role && <>, {t.role}</>}
						</footer>
					</blockquote>
				</li>
			))}
		</ul>
	</section>

	<section class="container section bg-subtle">
		<h2>Frequently asked questions</h2>
		<div class="faq-list">
			{faqs.map((faq) => (
				<details class="faq-item">
					<summary>{faq.question}</summary>
					<p>{faq.answer}</p>
				</details>
			))}
		</div>
	</section>

	<section class="container section cta-section">
		<h2>Ready to get started?</h2>
		<p class="lead">Replace with a closing line that restates the outcome and makes the next step obvious.</p>
		<a href="/contact/" class="btn btn-primary">Get in touch</a>
	</section>
</BaseLayout>

<style>
	.section {
		padding-block: var(--space-2xl);
	}

	.bg-subtle {
		background: var(--color-bg-subtle);
	}

	.lead {
		font-size: var(--text-large);
		max-width: 640px;
	}

	.hero {
		padding-bottom: var(--space-xl);
	}

	.section-note {
		max-width: 640px;
	}

	/* Problems */
	.problem-grid {
		list-style: none;
		margin: var(--space-xl) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-lg);
	}

	.problem-card h3 {
		font-size: var(--text-h4);
	}

	.problem-card p {
		margin-bottom: 0;
	}

	/* Services */
	.service-grid {
		list-style: none;
		margin: var(--space-xl) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-lg);
	}

	.service-card {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-lg);
	}

	.service-card h3 {
		font-size: var(--text-h4);
	}

	.includes-list {
		margin: var(--space-md) 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.includes-list li {
		font-size: var(--text-small);
		color: var(--color-text-secondary);
		padding-left: var(--space-md);
		position: relative;
	}

	.includes-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-text-secondary);
	}

	/* How it works */
	.step-list {
		list-style: none;
		margin: var(--space-xl) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--space-xl);
	}

	.step-number {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		background: var(--color-ink);
		color: var(--color-ink-contrast);
		font-weight: var(--weight-semibold);
		margin-bottom: var(--space-sm);
	}

	.step h3 {
		font-size: var(--text-h4);
	}

	.step p {
		margin-bottom: 0;
	}

	/* Pricing */
	.pricing-grid {
		list-style: none;
		margin: var(--space-xl) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-lg);
		align-items: start;
	}

	.pricing-card {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-lg);
		display: flex;
		flex-direction: column;
	}

	.pricing-card.featured {
		border: 2px solid var(--color-ink);
	}

	.pricing-badge {
		font-size: var(--text-small);
		font-weight: var(--weight-semibold);
		color: var(--color-text);
		margin: 0 0 var(--space-sm);
	}

	.pricing-card h3 {
		font-size: var(--text-h4);
		margin-bottom: var(--space-xs);
	}

	.pricing-price {
		font-size: var(--text-h2);
		font-weight: var(--weight-semibold);
		margin: 0 0 var(--space-sm);
	}

	.pricing-unit {
		font-size: var(--text-small);
		font-weight: var(--weight-normal);
		color: var(--color-text-secondary);
	}

	.pricing-description {
		color: var(--color-text-secondary);
	}

	.pricing-features {
		list-style: none;
		margin: 0 0 var(--space-lg);
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		flex-grow: 1;
	}

	.pricing-features li {
		font-size: var(--text-small);
		padding-left: var(--space-md);
		position: relative;
	}

	.pricing-features li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-text-secondary);
	}

	.pricing-cta {
		text-align: center;
		margin-top: auto;
	}

	/* Testimonials */
	.testimonial-grid {
		list-style: none;
		margin: var(--space-xl) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-lg);
	}

	.testimonial-card {
		margin: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-lg);
	}

	.testimonial-card p {
		font-size: var(--text-large);
		color: var(--color-text);
		margin-bottom: var(--space-md);
	}

	.testimonial-card footer {
		font-size: var(--text-small);
		color: var(--color-text-secondary);
	}

	.testimonial-card cite {
		font-style: normal;
		font-weight: var(--weight-semibold);
		color: var(--color-text);
	}

	/* FAQ */
	.faq-list {
		margin-top: var(--space-xl);
		max-width: 720px;
		display: flex;
		flex-direction: column;
	}

	.faq-item {
		border-bottom: 1px solid var(--color-border);
	}

	/* Padding lives on the summary itself, not the wrapping .faq-item, so
	   the whole tappable row (not just the text line) is a comfortable
	   touch target on mobile. */
	.faq-item summary {
		padding-block: var(--space-md);
		cursor: pointer;
		font-weight: var(--weight-semibold);
		color: var(--color-text);
		list-style: none;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary::before {
		content: '+';
		display: inline-block;
		width: 1.25em;
		font-weight: var(--weight-normal);
		color: var(--color-text-secondary);
	}

	.faq-item[open] summary::before {
		content: '\2212';
	}

	.faq-item p {
		margin: 0 0 var(--space-md) 1.25em;
	}

	/* Final CTA */
	.cta-section {
		text-align: center;
	}

	.cta-section .lead {
		margin-inline: auto;
	}
</style>
