---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_PHONE, SITE_EMAIL, SITE_ADDRESS } from '../consts';

// Placeholder content throughout — replace every field before launch.
// Section order follows the standard small-business homepage pattern:
// hero → trust signals → services preview → why-us → work preview →
// testimonials → contact. Services/gallery previews intentionally reuse
// a few real items from those pages rather than inventing new copy, so
// there's one source of truth to edit.
const schema = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness', // TODO: swap for the more specific type if one fits (Restaurant, Plumber, ProfessionalService, etc.)
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: Astro.site,
};

const trustSignals = [
	'Replace with a trust signal (e.g. "Licensed & insured")',
	'Replace with a trust signal (e.g. "5-star rated")',
	'Replace with a trust signal (e.g. "Serving [area] since 20XX")',
];

const services = [
	{
		title: 'Service one',
		description: 'Replace with a real description of what this includes.',
	},
	{
		title: 'Service two',
		description: 'Replace with a real description of what this includes.',
	},
	{
		title: 'Service three',
		description: 'Replace with a real description of what this includes.',
	},
];

const benefits = [
	{ title: 'Fast, reliable service', description: 'Replace with what makes response time or turnaround a real advantage.' },
	{ title: 'Transparent, upfront pricing', description: 'Replace with how you handle quotes — no surprise costs.' },
	{ title: 'Locally owned and operated', description: 'Replace with real local/community credibility.' },
	{ title: 'Satisfaction guaranteed', description: 'Replace with the real guarantee or standard you hold work to.' },
];

const galleryPreview = [
	{ src: '/images/gallery/placeholder-1.svg', alt: 'Replace with a real, descriptive alt text for this photo' },
	{ src: '/images/gallery/placeholder-2.svg', alt: 'Replace with a real, descriptive alt text for this photo' },
	{ src: '/images/gallery/placeholder-3.svg', alt: 'Replace with a real, descriptive alt text for this photo' },
];

const testimonials = [
	{
		quote: 'Replace with a real quote from a client — specific results read as more credible than generic praise.',
		name: 'Client name',
		role: 'Replace with their role or company',
	},
	{
		quote: 'Replace with a second real quote, ideally from a different type of client to show range.',
		name: 'Client name',
		role: 'Replace with their role or company',
	},
];
---

<BaseLayout title="Home" description={SITE_DESCRIPTION}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<section class="section-loose">
		<div class="container">
			<div class="hero">
				<h1 class="display">Headline that says what you do and for whom</h1>
				<p class="lead hero-sub">
					One or two sentences of supporting copy. Lead with the outcome the visitor
					cares about, not a list of features.
				</p>
				<div class="hero-actions">
					<a href="/contact/" class="btn btn-primary btn-lg">Get in touch</a>
					<a href="/gallery/" class="btn btn-secondary btn-lg">See our work</a>
				</div>
			</div>
		</div>
	</section>

	<section class="trust-bar" aria-label="Why clients trust us">
		<div class="container">
			<ul>
				{trustSignals.map((signal) => (
					<li>{signal}</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow">Services</p>
			<h2>What we do</h2>
			<p class="lead">
				Short section introducing the core service(s) — answer the question a visitor is
				actually asking when they land here. See the full <a href="/services/">list of services</a>,
				including pricing and how the process works.
			</p>
			<ul class="grid-auto section-grid">
				{services.map((service) => (
					<li class="card card-interactive">
						<h3>{service.title}</h3>
						<p class="text-secondary">{service.description}</p>
					</li>
				))}
			</ul>
			<a href="/services/" class="btn btn-secondary">View all services</a>
		</div>
	</section>

	<section class="section section-sunken">
		<div class="container">
			<p class="eyebrow">Why us</p>
			<h2>Why choose us</h2>
			<ul class="grid-auto section-grid section-grid-last">
				{benefits.map((benefit) => (
					<li class="benefit">
						<h3>{benefit.title}</h3>
						<p class="text-secondary">{benefit.description}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow">Portfolio</p>
			<h2>Our work</h2>
			<p class="lead">
				A look at recent projects — visit the <a href="/gallery/">full gallery</a> for more.
			</p>
			<ul class="work-grid">
				{galleryPreview.map((image) => (
					<li>
						<a href="/gallery/" class="work-item">
							<img src={image.src} alt={image.alt} loading="lazy" />
						</a>
					</li>
				))}
			</ul>
			<a href="/gallery/" class="btn btn-secondary">View full gallery</a>
		</div>
	</section>

	<section class="section section-sunken">
		<div class="container">
			<p class="eyebrow">Testimonials</p>
			<h2>What clients say</h2>
			<ul class="grid-auto section-grid section-grid-last">
				{testimonials.map((t) => (
					<li>
						<blockquote class="card testimonial">
							<p class="testimonial-quote">&ldquo;{t.quote}&rdquo;</p>
							<footer class="testimonial-attribution">
								<cite>{t.name}</cite>{t.role && <>, {t.role}</>}
							</footer>
						</blockquote>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="contact-grid">
				<div>
					<p class="eyebrow">Contact</p>
					<h2>Get in touch</h2>
					<p class="text-secondary measure">
						Replace with a short line inviting the visitor to reach out — restate the outcome
						one more time before they leave the page.
					</p>
					<p class="contact-details">
						<a href={`tel:${SITE_PHONE.replace(/[^\d+]/g, '')}`}>{SITE_PHONE}</a>
						<br />
						<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
						{SITE_ADDRESS && (
							<>
								<br />
								{SITE_ADDRESS}
							</>
						)}
					</p>
				</div>
				<div>
					<ContactForm />
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		max-width: var(--measure);
	}

	.hero-sub {
		margin-bottom: var(--space-6);
	}

	.hero-actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
	}

	/* Grid sitting between a section intro and the section's closing CTA. */
	.section-grid {
		margin-block: var(--space-7);
	}

	/* Last element in its section — no trailing margin to double up on the
	   section's own padding. */
	.section-grid-last {
		margin-bottom: 0;
	}

	/* Trust bar — a thin rule between the hero and the first real section,
	   full-bleed so the hairlines run the whole width. */
	.trust-bar {
		padding-block: var(--space-5);
		border-block: 1px solid var(--border-hairline);
	}

	.trust-bar ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-7);
	}

	.trust-bar li {
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text-secondary);
	}

	/* Benefits are borderless on purpose — the sunken band already separates
	   them from the page, so adding cards on top would be layering twice for
	   one level of hierarchy. */
	.benefit h3 {
		font-size: var(--text-h4);
	}

	.benefit p:last-child {
		margin-bottom: 0;
	}

	.card h3 {
		font-size: var(--text-h4);
	}

	/* Work preview */
	.work-grid {
		list-style: none;
		margin-block: var(--space-7);
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
	}

	.work-item {
		display: block;
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.work-item img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		background: var(--surface-sunken);
		transition: transform var(--duration-slow) var(--ease-out);
	}

	.work-item:hover img {
		transform: scale(1.03);
	}

	@media (max-width: 640px) {
		.work-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 400px) {
		.work-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Testimonials */
	.testimonial {
		margin: 0;
	}

	.testimonial-quote {
		font-size: var(--text-large);
		line-height: var(--leading-body);
		color: var(--color-text);
		margin-bottom: var(--space-4);
	}

	.testimonial-attribution {
		font-size: var(--text-small);
		color: var(--color-text-tertiary);
	}

	.testimonial-attribution cite {
		font-style: normal;
		font-weight: var(--weight-medium);
		color: var(--color-text);
	}

	/* Contact — two columns, last section before the footer */
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-9);
		align-items: start;
	}

	.contact-details {
		margin-top: var(--space-5);
		margin-bottom: 0;
		font-size: var(--text-large);
	}

	@media (max-width: 720px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: var(--space-7);
		}
	}
</style>
