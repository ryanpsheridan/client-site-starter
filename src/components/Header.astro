---
import { NAV_LINKS, SITE_TITLE } from '../consts';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="container site-header-inner">
		<a href="/" class="site-logo">{SITE_TITLE}</a>

		<nav class="desktop-nav" aria-label="Primary">
			<ul>
				{NAV_LINKS.map((link) => (
					<li>
						<a
							href={link.href}
							class="nav-link"
							aria-current={currentPath === link.href ? 'page' : undefined}
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<button
			id="menu-toggle"
			class="menu-toggle"
			type="button"
			aria-haspopup="dialog"
			aria-expanded="false"
			aria-controls="app-menu"
			aria-label="Menu"
		>
			<span class="bar bar-top"></span>
			<span class="bar bar-bottom"></span>
		</button>
	</div>
</header>

<div id="app-menu" class="app-menu" role="dialog" aria-modal="true" aria-label="Menu">
	<nav aria-label="Primary">
		<ul>
			{NAV_LINKS.map((link) => (
				<li>
					<a
						href={link.href}
						class="menu-item"
						aria-current={currentPath === link.href ? 'page' : undefined}
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</div>

<script>
	const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
	const menu = document.getElementById('app-menu') as HTMLDivElement;

	function openMenu() {
		menu.classList.add('open');
		toggle.classList.add('open');
		toggle.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
		menu.querySelector<HTMLAnchorElement>('.menu-item')?.focus();
	}

	function closeMenu() {
		menu.classList.remove('open');
		toggle.classList.remove('open');
		toggle.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}

	function toggleMenu() {
		if (menu.classList.contains('open')) {
			closeMenu();
			toggle.focus();
		} else {
			openMenu();
		}
	}

	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;

		if (target.closest('#menu-toggle')) {
			toggleMenu();
			return;
		}

		if (target.closest('.app-menu a.menu-item')) {
			closeMenu();
		}
	});

	document.addEventListener('keydown', (e) => {
		if (!menu.classList.contains('open')) return;

		if (e.key === 'Escape') {
			closeMenu();
			toggle.focus();
			return;
		}

		// Focus trap. The overlay is aria-modal, so focus must not escape it
		// while it's open — without this, tabbing past the last link lands on
		// browser chrome or page content the user can't see.
		if (e.key !== 'Tab') return;

		const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>('.menu-item'));
		if (items.length === 0) return;

		const first = items[0];
		const last = items[items.length - 1];
		const active = document.activeElement;

		if (e.shiftKey && (active === first || !menu.contains(active))) {
			e.preventDefault();
			last.focus();
		} else if (!e.shiftKey && active === last) {
			e.preventDefault();
			first.focus();
		}
	});
</script>

<style>
	/* Sticky so the nav stays reachable on long pages. A hairline bottom
	   border rather than a shadow — the header sits in the page, it doesn't
	   float above it. */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 41;
		background: var(--surface-page);
		border-bottom: 1px solid var(--border-hairline);
		padding-top: env(safe-area-inset-top);
	}

	.site-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
		padding-block: var(--space-4);
	}

	.site-logo {
		font-family: var(--font-heading);
		font-weight: var(--weight-medium);
		font-size: var(--text-h4);
		letter-spacing: var(--tracking-snug);
		text-transform: lowercase;
		color: var(--color-text);
		text-decoration: none;
		white-space: nowrap;
	}

	/* --- Desktop nav ------------------------------------------------------ */

	/* Hidden by default and revealed at the breakpoint, so the mobile overlay
	   stays the baseline experience rather than a fallback. */
	.desktop-nav {
		display: none;
	}

	.desktop-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		gap: var(--space-5);
	}

	.nav-link {
		position: relative;
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text-secondary);
		text-decoration: none;
		padding-block: var(--space-2);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.nav-link:hover {
		color: var(--color-text);
	}

	/* The underline is a pseudo-element rather than text-decoration so the
	   current-page state can animate and can't shift the text baseline. */
	.nav-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 1.5px;
		border-radius: var(--radius-pill);
		background: var(--color-text);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform var(--duration-base) var(--ease-out);
	}

	.nav-link[aria-current='page'] {
		color: var(--color-text);
	}

	.nav-link[aria-current='page']::after {
		transform: scaleX(1);
	}

	/* --- Hamburger toggle ------------------------------------------------- */

	/* Two bars that animate into an X on open — the same elements in both
	   states, so there's no icon swap. */
	.menu-toggle {
		position: relative;
		width: 38px;
		height: 38px;
		border: none;
		background: transparent;
		padding: 0;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition: transform var(--duration-fast) var(--ease-out);
	}

	.menu-toggle:active {
		transform: scale(0.94);
	}

	.menu-toggle .bar {
		position: absolute;
		left: 8px;
		width: 22px;
		height: 2px;
		border-radius: 2px;
		background: var(--color-text);
		transition:
			top var(--duration-base) var(--ease-out),
			transform var(--duration-base) var(--ease-out);
	}

	.menu-toggle .bar-top {
		top: 14px;
	}

	.menu-toggle .bar-bottom {
		top: 22px;
	}

	.menu-toggle.open .bar-top {
		top: 18px;
		transform: rotate(45deg);
	}

	.menu-toggle.open .bar-bottom {
		top: 18px;
		transform: rotate(-45deg);
	}

	/* --- Mobile overlay --------------------------------------------------- */

	/* Full-screen overlay menu. Sits just below the header in z-index so the
	   header stays visible with no seam. Visibility is delayed on close so the
	   hidden panel can't intercept clicks. */
	.app-menu {
		position: fixed;
		inset: 0;
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--surface-page);
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px);
		transition:
			opacity var(--duration-base) var(--ease-out),
			transform var(--duration-base) var(--ease-out),
			visibility 0s linear var(--duration-base);
	}

	.app-menu.open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		transition:
			opacity var(--duration-base) var(--ease-out),
			transform var(--duration-base) var(--ease-out),
			visibility 0s linear 0s;
	}

	.app-menu ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-7);
	}

	.menu-item {
		display: inline-block;
		font-family: var(--font-heading);
		font-size: var(--text-h3);
		font-weight: var(--weight-medium);
		letter-spacing: var(--tracking-snug);
		color: var(--color-text-secondary);
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
		transition:
			color var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	/* Color, not weight. Changing font-weight on hover reflows the text and
	   nudges every sibling — a layout shift triggered by pointer movement. */
	.menu-item:hover {
		color: var(--color-text);
	}

	.menu-item[aria-current='page'] {
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}

	.menu-item:active {
		transform: scale(0.97);
	}

	@media (max-width: 480px) {
		.app-menu ul {
			gap: var(--space-5);
		}
	}

	/* Swap the overlay for the inline nav. Both are removed from the
	   accessibility tree when not in use, so exactly one "Primary" navigation
	   landmark is ever exposed. */
	@media (min-width: 860px) {
		.site-logo {
			font-size: var(--text-h3);
		}

		.desktop-nav {
			display: block;
		}

		.menu-toggle,
		.app-menu {
			display: none;
		}
	}
</style>
