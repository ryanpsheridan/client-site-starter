---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';

// Placeholder content throughout this page — replace every field with the
// client's real offering before launch. Structure follows the standard
// service-business page pattern (problem → offer → process → pricing →
// social proof → FAQ → CTA) since that's what visitors and search/AI
// answer engines both expect from a services page.

const problems = [
	{
		title: 'Replace with a problem your client solves',
		description: 'Describe the pain point from the visitor’s point of view — what’s frustrating or costly about not having this handled.',
	},
	{
		title: 'Replace with a second problem',
		description: 'Keep it specific and concrete rather than generic — visitors recognize themselves in specifics, not buzzwords.',
	},
	{
		title: 'Replace with a third problem',
		description: 'Three is usually enough to establish credibility without turning this into a wall of text.',
	},
];

const services = [
	{
		title: 'Service one',
		description: 'Replace with a real description of what this includes.',
		includes: ['Replace with what’s included', 'Replace with what’s included', 'Replace with what’s included'],
	},
	{
		title: 'Service two',
		description: 'Replace with a real description of what this includes.',
		includes: ['Replace with what’s included', 'Replace with what’s included', 'Replace with what’s included'],
	},
	{
		title: 'Service three',
		description: 'Replace with a real description of what this includes.',
		includes: ['Replace with what’s included', 'Replace with what’s included', 'Replace with what’s included'],
	},
];

const steps = [
	{ title: 'Reach out', description: 'Replace with how a visitor starts — a call, a form, a quote request.' },
	{ title: 'We build a plan', description: 'Replace with what happens next — an assessment, a proposal, a scheduled visit.' },
	{ title: 'Get results', description: 'Replace with the outcome the client walks away with.' },
];

const pricingTiers = [
	{
		name: 'Starter',
		price: '$X',
		unit: '/ project',
		description: 'Replace with who this tier is for.',
		features: ['Replace with a feature', 'Replace with a feature', 'Replace with a feature'],
		featured: false,
	},
	{
		name: 'Standard',
		price: '$X',
		unit: '/ project',
		description: 'Replace with who this tier is for.',
		features: ['Everything in Starter', 'Replace with a feature', 'Replace with a feature', 'Replace with a feature'],
		featured: true,
	},
	{
		name: 'Premium',
		price: '$X',
		unit: '/ project',
		description: 'Replace with who this tier is for.',
		features: ['Everything in Standard', 'Replace with a feature', 'Replace with a feature'],
		featured: false,
	},
];

const testimonials = [
	{
		quote: 'Replace with a real quote from a client — specific results read as more credible than generic praise.',
		name: 'Client name',
		role: 'Replace with their role or company',
	},
	{
		quote: 'Replace with a second real quote, ideally from a different type of client to show range.',
		name: 'Client name',
		role: 'Replace with their role or company',
	},
];

const faqs = [
	{
		question: 'Replace with a real question clients actually ask',
		answer: 'Replace with a direct, specific answer — this doubles as AEO content, so phrase both the question and answer the way a person would actually ask and expect to hear it.',
	},
	{
		question: 'How long does a typical project take?',
		answer: 'Replace with a real timeframe or range.',
	},
	{
		question: 'What areas or industries do you serve?',
		answer: 'Replace with real service-area or industry detail.',
	},
	{
		question: 'How do I get started?',
		answer: 'Replace with the real first step — usually a link back to the contact page.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer,
		},
	})),
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	provider: {
		'@type': 'LocalBusiness',
		name: SITE_TITLE,
	},
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Services',
		itemListElement: services.map((service) => ({
			'@type': 'Offer',
			itemOffered: {
				'@type': 'Service',
				name: service.title,
				description: service.description,
			},
		})),
	},
};
---

<BaseLayout
	title="Services"
	description="What we offer, how it works, and what it costs — everything you need to know before reaching out."
>
	<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<section class="section-hero">
		<div class="container">
			<div class="page-hero">
				<h1>Services</h1>
				<p class="lead">
					One or two sentences summarizing the range of services and the outcome a client gets —
					lead with the result, the same way the homepage headline does.
				</p>
				<a href="/contact/" class="btn btn-primary btn-lg">Get a free quote</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-header">
				<div class="section-header-text">
					<p class="eyebrow">The problem</p>
					<h2>Common problems we solve</h2>
				</div>
			</div>
			<ul class="grid-auto">
				{problems.map((problem) => (
					<li class="topline">
						<h3>{problem.title}</h3>
						<p class="text-secondary">{problem.description}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section-sunken">
		<div class="container">
			<div class="section-header">
				<div class="section-header-text">
					<p class="eyebrow">The offer</p>
					<h2>What we offer</h2>
				</div>
				<a href="/contact/" class="link-arrow">Get a quote</a>
			</div>
			<ul class="grid-auto">
				{services.map((service) => (
					<li class="card card-interactive">
						<h3>{service.title}</h3>
						<p class="text-secondary">{service.description}</p>
						<ul class="includes-list">
							{service.includes.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-header">
				<div class="section-header-text">
					<p class="eyebrow">The process</p>
					<h2>How it works</h2>
				</div>
			</div>
			<ol class="grid-auto step-list">
				{steps.map((step, i) => (
					<li class="step">
						<span class="step-number" aria-hidden="true">{i + 1}</span>
						<h3>{step.title}</h3>
						<p class="text-secondary">{step.description}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section section-sunken">
		<div class="container">
			<div class="section-header">
				<div class="section-header-text">
					<p class="eyebrow">Pricing</p>
					<h2>What it costs</h2>
					<p class="lead">Starting prices below — every project is a little different, so treat these as a guide and reach out for an exact quote.</p>
				</div>
			</div>
			<ul class="grid-auto pricing-grid">
				{pricingTiers.map((tier) => (
					<li class:list={['card', 'pricing-card', { featured: tier.featured }]}>
						{tier.featured && <p class="pricing-badge">Most popular</p>}
						<h3>{tier.name}</h3>
						<p class="pricing-price">{tier.price}<span class="pricing-unit">{tier.unit}</span></p>
						<p class="pricing-description text-secondary">{tier.description}</p>
						<ul class="pricing-features">
							{tier.features.map((feature) => (
								<li>{feature}</li>
							))}
						</ul>
						<a href="/contact/" class={`btn ${tier.featured ? 'btn-primary' : 'btn-secondary'} pricing-cta`}>Get started</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<ul class="grid-auto testimonial-grid">
				{testimonials.map((t) => (
					<li>
						<blockquote class="quote">
							<p>{t.quote}</p>
							<footer>
								<cite>{t.name}</cite>{t.role && <>, {t.role}</>}
							</footer>
						</blockquote>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section-sunken">
		<div class="container">
			<div class="section-header">
				<div class="section-header-text">
					<p class="eyebrow">Questions</p>
					<h2>Frequently asked questions</h2>
				</div>
			</div>
			<div class="faq-list">
				{faqs.map((faq) => (
					<details class="faq-item">
						<summary>{faq.question}</summary>
						<p class="text-secondary">{faq.answer}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="section cta-band">
		<div class="container">
			<div class="cta-inner">
				<h2>Ready to get started?</h2>
				<p class="cta-lead">Replace with a closing line that restates the outcome and makes the next step obvious.</p>
				<div class="cta-actions">
					<a href="/contact/" class="btn btn-inverse btn-lg">Get in touch</a>
					<a href="/gallery/" class="link-arrow cta-link">See our work</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		max-width: var(--measure);
	}

	.page-hero .lead {
		margin-bottom: var(--space-6);
	}

	/* Problems are borderless — the section reads as a list of statements,
	   not a set of objects, so cards would over-structure it. */
	.card h3,
	.topline h3 {
		font-size: var(--text-h4);
	}

	/* Services */
	.includes-list {
		margin: var(--space-4) 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.includes-list li {
		font-size: var(--text-small);
		color: var(--color-text-secondary);
		padding-left: var(--space-4);
		position: relative;
	}

	.includes-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--border-strong);
	}

	/* How it works */
	.step-list {
		--grid-min: 200px;
		gap: var(--space-7);
	}

	.step-number {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		background: var(--color-ink);
		color: var(--color-ink-contrast);
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		margin-bottom: var(--space-4);
	}

	.step h3 {
		font-size: var(--text-h4);
	}

	.step p:last-child {
		margin-bottom: 0;
	}

	/* Pricing */
	.pricing-grid {
		align-items: start;
	}

	.pricing-card {
		display: flex;
		flex-direction: column;
	}

	/* Ring rather than a 2px border, so the featured tier doesn't sit 1px
	   taller than its neighbours and break the row's baseline. */
	.pricing-card.featured {
		border-color: var(--color-ink);
		box-shadow: inset 0 0 0 1px var(--color-ink), var(--shadow-md);
	}

	.pricing-badge {
		font-size: var(--text-eyebrow);
		font-weight: var(--weight-medium);
		letter-spacing: var(--tracking-caps);
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0 0 var(--space-3);
	}

	.pricing-card h3 {
		font-size: var(--text-h4);
		margin-bottom: var(--space-1);
	}

	.pricing-price {
		font-size: var(--text-h2);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-snug);
		line-height: var(--leading-tight);
		margin: 0 0 var(--space-3);
	}

	.pricing-unit {
		font-size: var(--text-small);
		font-weight: var(--weight-normal);
		letter-spacing: var(--tracking-normal);
		color: var(--color-text-tertiary);
		margin-left: var(--space-1);
	}

	.pricing-features {
		list-style: none;
		margin: 0 0 var(--space-6);
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		flex-grow: 1;
	}

	.pricing-features li {
		font-size: var(--text-small);
		padding-left: var(--space-4);
		position: relative;
	}

	.pricing-features li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--border-strong);
	}

	.pricing-cta {
		margin-top: auto;
	}

	/* Testimonials */
	.testimonial-grid {
		--grid-min: 340px;
		gap: var(--space-7);
	}

	/* FAQ */
	.faq-list {
		max-width: var(--measure-wide);
		border-top: 1px solid var(--border-default);
	}

	.faq-item {
		border-bottom: 1px solid var(--border-default);
	}

	/* Padding lives on the summary itself, not the wrapping .faq-item, so
	   the whole tappable row (not just the text line) is a comfortable
	   touch target on mobile. */
	.faq-item summary {
		display: flex;
		gap: var(--space-3);
		padding-block: var(--space-4);
		cursor: pointer;
		font-weight: var(--weight-medium);
		color: var(--color-text);
		list-style: none;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary::before {
		content: '+';
		flex-shrink: 0;
		width: 1em;
		font-weight: var(--weight-normal);
		color: var(--color-text-tertiary);
	}

	.faq-item[open] summary::before {
		content: '\2212';
	}

	.faq-item p {
		margin: 0 0 var(--space-4);
		padding-left: calc(1em + var(--space-3));
		max-width: var(--measure);
	}

	/* Final CTA */
	.cta-inner {
		max-width: var(--measure);
	}

	.cta-lead {
		font-size: var(--text-large);
		margin-bottom: var(--space-6);
	}

	.cta-actions {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		flex-wrap: wrap;
	}

	.cta-link,
	.cta-link:hover {
		color: var(--color-ink-contrast);
	}
</style>
