---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_EMAIL, SITE_PHONE, SITE_ADDRESS } from '../consts';

// ---------------------------------------------------------------------------
// PAGE CONTENT — everything a client edit touches lives in this block.
//
// Hours and the response-time line are the two things visitors look for after
// the phone number. Delete either if it doesn't apply rather than guessing.
// ---------------------------------------------------------------------------

const intro = {
	eyebrow: 'Contact',
	heading: 'Get in touch',
	lead: 'Replace with a line telling the visitor what happens after they send this — how fast someone replies, and what they should include.',
};

const hours = [
	{ days: 'Monday – Friday', time: 'Replace with real hours' },
	{ days: 'Saturday', time: 'Replace with real hours' },
	{ days: 'Sunday', time: 'Closed' },
];

const responseNote = 'Replace with a real response-time commitment (e.g. "We reply to every message within one business day").';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: `Contact ${SITE_TITLE}`,
	description: intro.lead,
	url: Astro.site ? new URL('/contact/', Astro.site).toString() : undefined,
};
---

<BaseLayout
	title="Contact"
	description="Phone, email, and hours — plus a form that reaches us directly."
>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<section class="section">
		<div class="container">
			<div class="split split-top" style="--split-cols: 1fr 1.15fr;">
				<div class="contact-info">
					<p class="eyebrow">{intro.eyebrow}</p>
					<h1>{intro.heading}</h1>
					<p class="lead">{intro.lead}</p>

					<div class="card card-tint details-card" style="--card-tint: var(--tint-cream);">
						<dl class="contact-list">
							<dt>Phone</dt>
							<dd>
								<a href={`tel:${SITE_PHONE.replace(/[^\d+]/g, '')}`}>{SITE_PHONE}</a>
								<button type="button" class="copy-btn" data-copy={SITE_PHONE} aria-label={`Copy phone number ${SITE_PHONE}`}>
									<span class="copy-icon copy-icon-idle"><Icon name="copy" size={16} /></span>
									<span class="copy-icon copy-icon-done"><Icon name="check" size={16} /></span>
								</button>
							</dd>

							<dt>Email</dt>
							<dd>
								<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
								<button type="button" class="copy-btn" data-copy={SITE_EMAIL} aria-label={`Copy email address ${SITE_EMAIL}`}>
									<span class="copy-icon copy-icon-idle"><Icon name="copy" size={16} /></span>
									<span class="copy-icon copy-icon-done"><Icon name="check" size={16} /></span>
								</button>
							</dd>

							{SITE_ADDRESS && (
								<>
									<dt>Address</dt>
									<dd>{SITE_ADDRESS}</dd>
								</>
							)}
						</dl>

						{/* Confirmation is announced rather than left as a purely visual
						    icon swap — the check alone says nothing to a screen reader. */}
						<p class="visually-hidden" role="status" aria-live="polite" id="copy-status"></p>

						<div class="hours">
							<h2 class="hours-heading">Hours</h2>
							<ul>
								{hours.map((row) => (
									<li>
										<span class="hours-days">{row.days}</span>
										<span class="hours-time">{row.time}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				</div>

				<div class="card form-card">
					<h2 class="form-heading">Send a message</h2>
					<p class="text-secondary form-note">{responseNote}</p>
					<ContactForm />
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	// Tap-to-copy on the phone and email. Progressive enhancement: the buttons
	// are inert without JS, and the values stay selectable links either way.
	const status = document.getElementById('copy-status');

	document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const value = btn.dataset.copy;
			if (!value) return;

			try {
				await navigator.clipboard.writeText(value);
			} catch {
				// Clipboard access can be refused (insecure context, denied
				// permission). Saying nothing would look like a dead button.
				if (status) status.textContent = 'Copy failed — select the text to copy it manually.';
				return;
			}

			btn.classList.add('copied');
			if (status) status.textContent = `Copied ${value} to clipboard.`;
			// Long enough to register, short enough that it's back to normal
			// before anyone tries a second copy.
			setTimeout(() => btn.classList.remove('copied'), 1600);
		});
	});
</script>

<style>
	.contact-info {
		max-width: var(--measure);
	}

	/* Details sit in a tinted card so the page isn't two plain columns of text.
	   The card re-points the muted text tokens, so the dt/hours styling below
	   lands on tint-safe tones without any override here. */
	.details-card {
		margin-top: var(--space-7);
		padding: var(--space-6);
	}

	/* Definition list rather than paragraphs — phone/email/address are labelled
	   pairs, and the markup should say so for anyone using a screen reader. */
	.contact-list {
		margin: 0;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-3) var(--space-6);
		align-items: baseline;
	}

	.contact-list dt {
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text-tertiary);
	}

	.contact-list dd {
		margin: 0;
		font-size: var(--text-large);
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	/* Copy button. Sits quiet until the row is hovered or it's focused, so the
	   contact details read as text rather than as a toolbar. It stays fully
	   visible on touch, where there's no hover to reveal it. */
	.copy-btn {
		display: inline-grid;
		place-items: center;
		flex-shrink: 0;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		border: 0;
		border-radius: var(--radius-sm);
		background: none;
		color: var(--color-text-tertiary);
		cursor: pointer;
		opacity: 0;
		-webkit-tap-highlight-color: transparent;
		transition:
			opacity var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out),
			background-color var(--duration-fast) var(--ease-out);
	}

	.contact-list dd:hover .copy-btn,
	.copy-btn:focus-visible {
		opacity: 1;
	}

	@media (hover: none) {
		.copy-btn {
			opacity: 1;
		}
	}

	.copy-btn:hover {
		color: var(--color-text);
		background: color-mix(in srgb, var(--color-text) 8%, transparent);
	}

	/* Both icons occupy the same cell, so swapping them can't reflow the row. */
	.copy-icon {
		grid-area: 1 / 1;
		display: grid;
		transition:
			opacity var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.copy-icon-done {
		opacity: 0;
		transform: scale(0.6);
	}

	.copy-btn.copied {
		opacity: 1;
		color: var(--color-accent-positive);
	}

	.copy-btn.copied .copy-icon-idle {
		opacity: 0;
		transform: scale(0.6);
	}

	.copy-btn.copied .copy-icon-done {
		opacity: 1;
		transform: scale(1);
	}

	/* Rule derived from the card's own text colour — --border-hairline is a
	   neutral tuned for the page surface and disappears on a tint. */
	.hours {
		margin-top: var(--space-6);
		padding-top: var(--space-5);
		border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
	}

	.hours-heading {
		font-size: var(--text-h5);
		font-weight: var(--weight-medium);
		color: var(--color-text-tertiary);
		margin-bottom: var(--space-3);
	}

	.hours ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		max-width: 22rem;
	}

	.hours li {
		display: flex;
		justify-content: space-between;
		gap: var(--space-5);
		font-size: var(--text-small);
	}

	.hours-days {
		color: var(--color-text);
	}

	.hours-time {
		color: var(--color-text-secondary);
	}

	/* Form */
	.form-card {
		padding: var(--space-7);
	}

	.form-heading {
		font-size: var(--text-h3);
	}

	.form-note {
		margin-bottom: var(--space-6);
	}

	@media (max-width: 560px) {
		.form-card {
			padding: var(--space-5);
		}
	}
</style>
