---
// Default form backend: Formspree. Replace FORMSPREE_ID below with the
// client's real form ID once their account is set up — see CLAUDE.md's
// "Forms" section for when to reach for an alternative instead. Shared
// by contact.astro and the homepage's closing contact section so both
// stay pointed at the same endpoint.
//
// Field styling comes from the shared .field component in global.css —
// don't re-declare it here.
const FORMSPREE_ACTION = 'https://formspree.io/f/FORMSPREE_ID';
---

<form action={FORMSPREE_ACTION} method="POST" class="contact-form">
	<div class="field">
		<label for="name">Name</label>
		<input type="text" id="name" name="name" required autocomplete="name" />
	</div>
	<div class="field">
		<label for="email">Email</label>
		<input type="email" id="email" name="email" required autocomplete="email" />
		<p class="field-hint">We'll only use this to reply to your message.</p>
	</div>
	<div class="field">
		<label for="message">Message</label>
		<textarea id="message" name="message" rows="5" required></textarea>
	</div>
	<button type="submit" class="btn btn-primary contact-submit">Send message</button>
</form>

<style>
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.contact-submit {
		align-self: flex-start;
	}
</style>
