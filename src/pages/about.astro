---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="Who we are and what we're about.">
	<section class="container section">
		<h1>About</h1>
		<p>
			Replace with the client's real story — who they are, how long they've been
			doing this, and why a visitor should trust them. This page should read
			like a person wrote it, not a template.
		</p>
	</section>
</BaseLayout>

<style>
	.section {
		padding-block: var(--space-2xl);
		max-width: 720px;
	}
</style>
